node_modules/

# The API key. Only .env.example is shared.
.env
.env.*
!.env.example

# The desk's working files: customer messages, replies, checker packets, handoffs and logs.
desk/
logs/
*.log

# Copies of Blotato's help pages, fetched through its docs MCP server on first run.
# They are Blotato's to publish, so they are not republished here.
.cache/
eval/reader-cache/test*/
# Held-out exams that are not committed, and the composer's verdicts for any held-out set (they paraphrase its messages).
eval/tickets.test3.jsonl
eval/tickets.test4.jsonl
eval/composer-cache/test*/

# The built function folder (holds copies of Blotato help pages; never committed).
netlify/site-data/
.netlify/
