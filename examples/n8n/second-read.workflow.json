{
  "name": "Second Read: draft a support reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "second-read",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000001",
      "name": "Support message in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5b1f0c1e-0001-4d6a-9a11-0000000000aa"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5610/api/ticket",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.body.text }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000002",
      "name": "Ask Second Read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5b1f0c1e-0001-4d6a-9a11-0000000000c1",
              "leftValue": "={{ $json.outcome }}",
              "rightValue": "reply",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "5b1f0c1e-0001-4d6a-9a11-0000000000c2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "reply: cleared to send",
              "operator": {
                "type": "string",
                "operation": "notStartsWith"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000003",
      "name": "Needs a person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: $json.outcome, draftReply: $json.reply, handover: $json.escalationText || null, howChecked: $json.status, note: !$json.reply ? 'No draft for this one. Pass the hand-over note to a person on the team.' : $json.escalationText ? 'A person on the team decides this one. You may send the draft as a holding reply, then pass the hand-over note on.' : 'This draft has not passed the fresh check yet. A person on the team reads it before it goes out.' }) }}",
        "options": {}
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000004",
      "name": "Hand over to a person",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: $json.outcome, draftReply: $json.reply, howChecked: $json.status, note: 'A draft. Read it, then send it yourself.' }) }}",
        "options": {}
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000005",
      "name": "Draft reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "content": "## Second Read in n8n\nPOST a support message to this webhook as JSON: {\"text\": \"...\"}.\nIt asks Second Read for a checked draft and returns it.\nOnly a reply the fresh checker passed, word for word, comes back as a plain draft. Everything else (escalate, no answer, blocked, a composed reply, not yet checked) goes to a person with the hand-over note.\n\nSecond Read only reads. Nothing here sends a reply or changes an account: a person sends the draft.\n\nChange the URL in **Ask Second Read** to wherever Second Read runs. 127.0.0.1:5610 works when n8n runs on the same computer. (Use 127.0.0.1, not localhost: newer n8n looks up localhost as ::1 and cannot reach Second Read.)",
        "height": 260,
        "width": 420
      },
      "id": "5b1f0c1e-0001-4d6a-9a11-000000000006",
      "name": "About this flow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
  "connections": {
    "Support message in": {
      "main": [
        [
          {
            "node": "Ask Second Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Second Read": {
      "main": [
        [
          {
            "node": "Needs a person?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs a person?": {
      "main": [
        [
          {
            "node": "Hand over to a person",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Draft reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
